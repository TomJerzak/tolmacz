<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Every public member must have a summary. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <IsPackable>true</IsPackable>
    <PackageId>Tolmacz</PackageId>
    <Version>1.0.0</Version>
    <Authors>Tomasz Jerzak</Authors>
    <Copyright>Copyright (c) 2026 Tomasz Jerzak</Copyright>
    <Description>Offline Polish-English translation for .NET on macOS and Windows. Translates in both directions on the CPU with ONNX Runtime, and keeps layout, numbers, addresses and links. The translation model is downloaded separately from https://github.com/TomJerzak/tolmacz-model.</Description>
    <PackageTags>translation;translator;machine-translation;polish;english;offline;onnx</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/TomJerzak/tolmacz</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/TomJerzak/tolmacz</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tolmacz.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.32.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="3.0.0" />
  </ItemGroup>

</Project>
